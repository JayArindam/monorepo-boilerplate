{
  "name": "boilerplate-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "nx run-many --target=dev --projects=backend,frontend,dashboard --output-style=stream",
    "dev:backend": "nx run backend:dev",
    "dev:frontend": "nx run frontend:dev",
    "dev:dashboard": "nx run dashboard:dev",
    "build": "nx run-many --target=build --all",
    "build:backend": "nx run backend:build",
    "build:frontend": "nx run frontend:build",
    "build:dashboard": "nx run dashboard:build",
    "start": "nx run-many --target=start --all",
    "test": "nx run-many --target=test --all",
    "lint": "nx run-many --target=lint --all",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rimraf node_modules apps/*/node_modules packages/*/node_modules .nx",
    "prepare": "husky",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "prettier --write",
      "eslint --fix --no-warn-ignored --flag unstable_config_lookup_from_file"
    ],
    "*.{json,md,css,scss,html,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "nx": "^22.7.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "overrides": {
    "axios": "1.16.0",
    "minimatch": "^10.0.0",
    "brace-expansion": "^5.0.5",
    "follow-redirects": "^1.15.12",
    "yaml": "^2.8.3"
  }
}
