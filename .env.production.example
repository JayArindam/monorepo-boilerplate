# ==============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE (.env.production.example)
# ==============================================================================
#
# This file serves as a reference for configuring the production environment of
# your monorepo. Do NOT copy this file directly to ".env" in production.
# Instead, follow the secrets management instructions below to inject these
# values securely at deploy time.
#
# SECRETS MANAGEMENT BEST PRACTICES:
# 1. NEVER commit a real ".env.production" or any secrets to source control.
# 2. Sensitive values (e.g., database credentials, API keys) must be stored in 
#    a secret vault like Google Cloud Secret Manager, AWS Secrets Manager, or
#    HashiCorp Vault.
# 3. Non-sensitive values (e.g., NODE_ENV, basic service configs) can be 
#    defined directly as environment variables on the hosting platform.
#
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND RUNTIME VARIABLES (Google Cloud Run / NestJS)
# ------------------------------------------------------------------------------
# These variables are read dynamically at runtime by the NestJS backend container.

# The environment mode. For production, always set this to "production".
NODE_ENV="production"

# The port on which the NestJS application listens.
# Note: Google Cloud Run injects the "PORT" environment variable automatically.
# You do not need to set this manually in Cloud Run configurations.
PORT=3000

# The production database connection string.
# Under GCP, if using Cloud SQL, you should connect via private IP (VPC) or
# the Cloud SQL Auth Proxy.
# Example: postgresql://<db_user>:<db_password>@<private_ip>:5432/<db_name>
# IMPORTANT: Store this connection string securely in GCP Secret Manager!
DATABASE_URL="postgresql://prod_user:SECRET_PASSWORD_FROM_SECRET_MANAGER@localhost:5432/prod_db"


# ------------------------------------------------------------------------------
# 2. FRONTEND & DASHBOARD BUILD-TIME VARIABLES (Vite / React 19)
# ------------------------------------------------------------------------------
# Crucial: Vite injects environment variables at BUILD-TIME, not runtime.
# This means their values are statically baked into the generated HTML/JS bundles
# when running "npm run build".
#
# If you are using a static hosting provider (e.g., Cloudflare Pages, Vercel, Netlify):
# Define these variables in your provider's dashboard under "Environment Variables".
# Make sure they are set for the "Production" environment so they are present during
# the build stage.

# The public URL of the production backend API.
# Note: Vite requires environment variables to be prefixed with "VITE_" to be
# exposed to the client-side code.
VITE_API_URL="https://api.yourproductiondomain.com"
